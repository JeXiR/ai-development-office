  },
  "reference_integrity_fix_v2": {
    "description": "Path validation now requires both a path-bearing key and a path-like value. Identifiers such as skill-routing are ignored.",
    "script": "scripts/validate-reference-integrity.ps1"
  },
  "doctor_execution_fix": {
    "description": "Doctor now executes command parity and behavioral contract checks instead of printing them as text, and reads HEALTHY version dynamically.",
    "script": "scripts/doctor.ps1"
  },
