{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment Contract",
  "type": "object",
  "properties": {
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "visibility": {
            "enum": [
              "public",
              "private",
              "secret"
            ]
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "visibility"
        ]
      }
    }
  }
}
