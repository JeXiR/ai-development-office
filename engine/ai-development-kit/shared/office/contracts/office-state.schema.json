{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Office State",
  "type": "object",
  "required": [
    "project_id",
    "project_name",
    "milestone",
    "agents"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_task": {
      "type": [
        "string",
        "null"
      ]
    },
    "health": {
      "enum": [
        "unknown",
        "healthy",
        "warning",
        "critical"
      ]
    },
    "roadmap_percent": {
      "type": [
        "number",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer"
        },
        "partial": {
          "type": "integer"
        },
        "todo": {
          "type": "integer"
        },
        "bugs": {
          "type": "integer"
        },
        "blockers": {
          "type": "integer"
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "skill": {
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
