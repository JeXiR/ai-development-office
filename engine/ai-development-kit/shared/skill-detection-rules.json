{
  "signals": [
    {
      "match": "composer.json contains laravel/framework",
      "skills": [
        "php",
        "laravel",
        "eloquent"
      ]
    },
    {
      "match": "resources/views/**/*.blade.php",
      "skills": [
        "blade"
      ]
    },
    {
      "match": "package.json contains react",
      "skills": [
        "react"
      ]
    },
    {
      "match": "package.json contains next",
      "skills": [
        "nextjs",
        "react"
      ]
    },
    {
      "match": "tsconfig.json or TypeScript dependency",
      "skills": [
        "typescript"
      ]
    },
    {
      "match": "tailwind dependency/config",
      "skills": [
        "tailwind"
      ]
    },
    {
      "match": "prisma/schema.prisma",
      "skills": [
        "prisma"
      ]
    },
    {
      "match": "database config indicates mysql",
      "skills": [
        "mysql"
      ]
    },
    {
      "match": "database config indicates postgres",
      "skills": [
        "postgres"
      ]
    },
    {
      "match": "Dockerfile",
      "skills": [
        "docker"
      ]
    },
    {
      "match": "compose/docker-compose file",
      "skills": [
        "docker",
        "docker-compose"
      ]
    },
    {
      "match": "Plesk deployment docs/config",
      "skills": [
        "plesk",
        "linux",
        "deployment"
      ]
    },
    {
      "match": "AWS references in docs/infra",
      "skills": [
        "aws-foundations"
      ]
    },
    {
      "match": "S3 storage config",
      "skills": [
        "aws-s3"
      ]
    },
    {
      "match": "ECS/Fargate infra",
      "skills": [
        "aws-ecs"
      ]
    },
    {
      "match": "RDS/Aurora infra",
      "skills": [
        "aws-rds"
      ]
    },
    {
      "match": "Expo dependency/app config",
      "skills": [
        "react-native",
        "expo"
      ]
    },
    {
      "match": "React Native dependency",
      "skills": [
        "react-native"
      ]
    }
  ],
