{
  "version": "2.0",
  "policy": {
    "default": "evaluate-before-use",
    "license_check_required_for_code_reuse": true,
    "prefer_existing_project_components": true,
    "prefer_existing_project_dependencies": true,
    "max_decorative_libraries_per_feature_default": 1
  },
  "categories": {
    "core-primitives": {
      "purpose": "accessible foundational interaction primitives",
      "preferred": [
        "shadcn-ui",
        "radix-ui"
      ]
    },
    "application-ui": {
      "purpose": "forms, dashboards, navigation, cards, tables and general product UI",
      "preferred": [
        "existing-project",
        "shadcn-ui",
        "flowbite",
        "hyperui",
        "tailwind-plus"
      ]
    },
    "marketing-ui": {
      "purpose": "landing pages, marketing sections and conversion-focused layouts",
      "preferred": [
        "magic-ui",
        "aceternity-ui",
        "react-bits",
        "hyperui",
        "tailwind-plus"
      ]
    },
    "animated-ui": {
      "purpose": "creative animated components and effects",
      "preferred": [
        "react-bits",
        "magic-ui",
        "animate-ui",
        "aceternity-ui",
        "motion"
      ]
    },
    "advanced-motion": {
      "purpose": "complex timelines, SVG, scroll-driven choreography",
      "preferred": [
        "gsap",
        "motion"
      ]
    },
    "3d-webgl": {
      "purpose": "3D, shaders, canvas and GPU-heavy visual effects",
      "preferred": [
        "three-js",
        "react-weather-effects"
      ]
    },
    "reference-tools": {
      "purpose": "visual inspiration, prototyping and interaction references",
      "preferred": [
        "nordcraft"
      ]
    }
  },
  "sources": [
