{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Kit Project Readiness",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "overall",
    "capabilities",
    "scaffold_ready"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "string"
    },
    "overall": {
      "enum": [
        "READY",
        "PARTIAL",
        "MISSING",
        "CONFLICT"
      ]
    },
    "scaffold_ready": {
      "type": "boolean"
    },
    "recommended_preset": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "required",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "READY",
              "PARTIAL",
              "MISSING",
              "CONFLICT"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
