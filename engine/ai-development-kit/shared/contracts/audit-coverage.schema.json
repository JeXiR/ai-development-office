{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Coverage",
  "type": "object",
  "required": [
    "schema_version",
    "areas"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "areas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "CHECKED",
              "PARTIAL",
              "NOT_CHECKED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
