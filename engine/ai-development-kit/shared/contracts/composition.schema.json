{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Kit Composition",
  "type": "object",
  "required": [
    "id",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "optional_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
