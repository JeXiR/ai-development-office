{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Kit Current Task v2",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "title",
    "command",
    "phase",
    "next_step"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done",
        "unknown"
      ]
    },
    "title": {
      "type": "string"
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_completed_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_state": {
      "enum": [
        "not_run",
        "running",
        "passed",
        "failed",
        "partial",
        "unknown"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
