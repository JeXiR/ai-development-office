{
  "name": "AI Development Office",
  "version": "2.1.9",
  "author": "JeXiR (Halil Cinkilinc)",
  "headless_kit_dependency": false,
  "user_application_code_modification": false,
  "telemetry_inputs": [
    ".ai-kit/events.jsonl",
    ".ai-kit/office-state.json"
  ],
  "roles": [
    "CEO",
    "PM",
    "Architect",
    "Backend",
    "Frontend",
    "Database",
    "QA",
    "Security",
    "DevOps",
    "Docs"
  ],
  "live_kit_integration": true,
  "launcher": [
    "office.ps1",
    "office.cmd",
    "npm run office"
  ],
  "ui_limits": {
    "live_events": 50,
    "panel_max_height_px": 430
  },
  "state_listener_log_policy": "log only when derived state changes",
  "multi_project": {
    "enabled": true,
    "config": "office.projects.json",
    "max_live_events_per_project": 50,
    "event_order": "newest_first"
  },
  "react_store_fix": "Stable Zustand selectors and shared empty state/event references",
  "project_removal": "Office registry only; never deletes project files",
  "command_center": {
    "queue_file": ".ai-kit/command-requests.jsonl",
    "history_file": "office.command-history.json",
    "runner_required_for_ai_execution": true,
    "v0_7_workflows": [
      "harvest project backlog",
      "audit frontend coverage",
      "audit backend coverage",
      "audit test gaps",
      "audit security",
      "audit devops",
      "find next work",
      "recheck completed work"
    ]
  },
  "pixel_office": {
    "engine": "PixiJS",
    "animation": "Direct Pixi Container movement via useTick",
    "sprites": "procedural v0.4; external licensed sprites can be added later",
    "rooms": [
      "CEO / War Room",
      "Planning & Architecture",
      "Ops & Knowledge",
      "Engineering",
      "Quality & Security",
      "Lounge"
    ]
  },
  "persistence": {
    "windows_default": "%LOCALAPPDATA%/AI-Development-Office",
    "upgrade_safe": true,
    "install_directory_runtime_state": false,
    "project_registry": "%LOCALAPPDATA%/AI-Development-Office/projects.json",
    "listener_uses_same_registry": true
  },
  "runner": {
    "providers": [
      "cursor",
      "claude"
    ],
    "project_selection": [
      "auto",
      "cursor",
      "claude"
    ],
    "auto_priority": [
      "cursor",
      "claude"
    ],
    "cursor_known_windows_path": "%LOCALAPPDATA%/cursor-agent/agent.cmd",
    "claude_known_windows_path": "%USERPROFILE%/.local/bin/claude.exe",
    "cursor_readonly": "agent -p",
    "cursor_mutating": "agent -p --force",
    "claude": "claude -p --permission-mode auto"
  },
  "workspace_trust": {
    "per_project": true,
    "default": false,
    "cursor_flag": "--trust",
    "write_permission_separate": true
  },
  "mission_control": {
    "layout": [
      "team-overview",
      "pixel-office",
      "ceo-mission-queue",
      "findings-workbench",
      "live-events"
    ],
    "persistent_queue_order": true,
    "finding_history": true,
    "agent_names_per_project": true
  },
  "react_snapshot_fix": {
    "stable_derived_hooks": true,
    "active_project_queue_hook": "src/hooks/useActiveProject.ts",
    "reason": "React 19 / Zustand getServerSnapshot stability"
  },
  "project_workbench": {
    "enabled": true,
    "sources": [
      "PROGRESS Todo",
      "PROGRESS Next Actions",
      "ROADMAP",
      "TEST_GAPS",
      "TENANT_ISOLATION",
      "security findings",
      "frontend audit"
    ],
    "persistent_work_ledger": ".ai-kit/office-work-items.json",
    "generated_workbench": ".ai-kit/office-workbench.json",
    "operations_lanes": [
      "todo",
      "fixing",
      "live-events"
    ]
  },
  "command_contract": {
    "work_item_fields": [
      "workItemId",
      "workItemTitle",
      "workItemType"
    ],
    "queue_fields": [
      "queueGroupId",
      "queueSequence",
      "attempt"
    ],
    "frontend_bridge_parity": true
  },
